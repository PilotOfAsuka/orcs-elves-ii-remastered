config_version=5

[application]
boot_splash/show_image=false
boot_splash/bg_color=Color(0.025,0.035,0.038,1)
config/name="Orcs & Elves II: Remastered"
config/version="0.0.3"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/original/icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="OrcsElves2Remastered"

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=480
window/size/window_height_override=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.04,0.045,1)
