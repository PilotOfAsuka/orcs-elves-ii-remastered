config_version=5

[application]
config/name="Orcs & Elves II — BREW"
config/version="0.1.0-brew-dev"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="OrcsElves2Brew"

[display]
window/size/viewport_width=360
window/size/viewport_height=640
window/size/window_width_override=480
window/size/window_height_override=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035,0.05,0.04,1)
